# ============================================
# 本地开发环境变量模板（spring-dotenv 自动加载）
# 复制本文件为 .env 并填入真实值，.env 已被 .gitignore 忽略
# ============================================

# MySQL 连接（本地容器映射端口 3307；docker-compose 用服务名 mysql:3306）
# MYSQL_USERNAME 默认 root 可省略
MYSQL_USERNAME=root
MYSQL_ROOT_PASSWORD=change_me

# RabbitMQ 连接
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=change_me
